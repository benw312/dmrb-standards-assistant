# Copy to .env and fill in. Endpoints and names only: auth is DefaultAzureCredential (az login).

# Foundry project endpoint: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=

# Deployment names as created in the Foundry portal
CHAT_DEPLOYMENT=gpt-4.1-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<search-name>.search.windows.net
AZURE_SEARCH_INDEX=dmrb-clauses

# Document Intelligence (needs a custom subdomain for Entra auth)
AZURE_DOCINTEL_ENDPOINT=https://<docintel-name>.cognitiveservices.azure.com/
